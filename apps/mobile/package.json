{
  "name": "vibeterminal-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "android:dev": "expo run:android",
    "android:release": "node scripts/build-android-release.cjs",
    "web": "expo start --web",
    "mock": "node scripts/mock-bridge.cjs",
    "capture": "node scripts/capture-web.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.cjs",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "prebuild": "node ../../scripts/sync-brand.cjs mobile && node scripts/make-notification-icon.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.22",
    "expo-background-task": "~57.0.17",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "typescript": "~6.0.3"
  }
}
