# Copy to apps/server/.env. Generate private values with scripts/create-secrets.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=3002
PUBLIC_URL=http://127.0.0.1:3002
DATABASE_URL=postgres://lina_app:REPLACE@127.0.0.1:5432/lina_accounts
MIGRATION_DATABASE_URL=postgres://lina_migrator:REPLACE@127.0.0.1:5432/lina_accounts
AUTH_SECRET_FILE=./data/secrets/auth-secret
OUTBOX_KEY_FILE=./data/secrets/outbox-key
METRICS_TOKEN_FILE=./data/secrets/metrics-token
# Signup needs working email. Usage collection is a separate explicit switch.
SIGNUP_ENABLED=false
USAGE_ENABLED=false
EMAIL_MODE=disabled
# For SMTP, set EMAIL_MODE=smtp, SMTP_HOST, EMAIL_FROM and optional credentials.
SMTP_PORT=587
SMTP_SECURE=false
TRUSTED_ORIGINS=
# Trust only the actual reverse-proxy peer IPs, never arbitrary forwarded headers.
TRUSTED_PROXY_IPS=
DB_POOL_MAX=10
