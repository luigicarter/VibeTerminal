{
  "openapi": "3.1.0",
  "info": {
    "title": "Lina prepared account additions — UNMOUNTED",
    "version": "0.1.0",
    "description": "Combined with the existing account contract only in dedicated test composition. Normal startup exposes none of these additions."
  },
  "paths": {
    "/api/desktop-auth/start": {
      "post": {
        "summary": "Start a 10-minute browser authorization attempt",
        "security": [],
        "x-lina-prepared": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "challenge": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "state": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "callback": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "installationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "windows",
                      "macos",
                      "linux"
                    ]
                  },
                  "appVersion": {
                    "type": "string",
                    "pattern": "^[0-9][0-9A-Za-z.+-]{0,39}$"
                  }
                },
                "required": [
                  "challenge",
                  "state",
                  "callback",
                  "installationId",
                  "platform",
                  "appVersion"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; never includes raw session tokens in JSON"
          },
          "400": {
            "description": "Invalid input or exchange"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Access, Origin or MFA denied"
          },
          "409": {
            "description": "Conflicting state"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Dependency unavailable or billing unconfigured"
          }
        }
      }
    },
