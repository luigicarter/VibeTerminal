# Copy to apps/server/data/server.env before Compose starts. Secrets live in files.
NODE_ENV=production
PUBLIC_URL=https://YOUR-DOMAIN
EMAIL_MODE=smtp
SMTP_HOST=YOUR-SMTP-HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR-SMTP-USER
# Supply SMTP_PASSWORD_FILE via a mounted secret when the provider needs a password.
EMAIL_FROM=Lina Terminal <accounts@YOUR-DOMAIN>
SIGNUP_ENABLED=false
USAGE_ENABLED=false
TRUSTED_PROXY_IPS=
