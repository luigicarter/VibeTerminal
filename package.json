{
  "name": "vibe-terminal",
  "version": "0.1.113",
  "private": true,
  "description": "A tiled local workspace for running multiple coding agents side by side.",
  "author": "Lina Terminal contributors",
  "homepage": "https://github.com/luigicarter/VibeTerminal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/luigicarter/VibeTerminal.git"
  },
  "main": "backend/main.cjs",
  "scripts": {
    "dev": "node scripts/app/dev.cjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:renderer": "npm run dev:frontend",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "screenshot": "node scripts/qa/screenshot.cjs",
    "screenshot:openfusion": "node scripts/qa/screenshot.cjs --openfusion",
    "screenshot:split": "node scripts/qa/screenshot.cjs --split",
    "smoke:backend:agent-telemetry": "node scripts/backend/agent-telemetry-smoke.cjs",
    "smoke:backend:terminal-runtime": "node scripts/backend/terminal-runtime-smoke.cjs && node --test scripts/backend/terminal-scrollback.test.cjs",
    "test:grok": "node --test scripts/backend/grok-*.test.cjs && node scripts/frontend/grok-integration-smoke.cjs",
    "smoke:grok:native": "node scripts/qa/grok-native-history-smoke.cjs",
    "test:terminal-status": "node --test scripts/backend/terminal-status-lifecycle.test.cjs scripts/backend/terminal-pending-activity.test.cjs scripts/backend/provider-status-telemetry.test.cjs scripts/backend/claude-task-telemetry.test.cjs scripts/backend/codex-hook-trust.test.cjs scripts/backend/kimi-task-observer.test.cjs scripts/backend/native-status-reconciliation.test.cjs scripts/backend/orchestrator-status-parity.test.cjs && node scripts/backend/terminal-runtime-smoke.cjs && node scripts/backend/agent-generation-telemetry-smoke.cjs && node scripts/backend/agent-telemetry-smoke.cjs && node scripts/frontend/terminal-runtime-smoke.cjs && node scripts/frontend/app-runtime-smoke.cjs",
    "smoke:codex:hook-trust": "node scripts/qa/codex-hook-trust-smoke.cjs",
    "smoke:backend:agent-generation": "node scripts/backend/agent-generation-telemetry-smoke.cjs",
    "smoke:backend:metadata": "node scripts/backend/metadata-discovery-smoke.cjs",
    "smoke:backend:code-changes": "node scripts/backend/code-changes-smoke.cjs",
    "smoke:backend:build-supervisor": "node scripts/backend/build-supervisor-smoke.cjs",
    "smoke:backend:launch-cwd": "node scripts/backend/launch-cwd-smoke.cjs",
    "smoke:backend:cli-probe": "node scripts/backend/cli-probe-smoke.cjs",
    "smoke:backend:codex-discovery": "node scripts/backend/codex-discovery-smoke.cjs",
    "smoke:backend:claude-discovery": "node scripts/backend/claude-discovery-smoke.cjs",
    "smoke:backend:kimi-discovery": "node scripts/backend/kimi-discovery-smoke.cjs",
    "smoke:backend:kimi-custom-discovery": "node scripts/backend/kimi-custom-discovery-smoke.cjs",
    "smoke:backend:qwen-discovery": "node scripts/backend/qwen-discovery-smoke.cjs",
    "smoke:backend:updates": "node scripts/backend/update-smoke.cjs && node --test scripts/backend/main-navigation.test.cjs",
    "smoke:backend:fusion-appserver": "node scripts/backend/fusion-appserver-smoke.cjs",
    "smoke:backend:fusion-launch": "node scripts/backend/fusion-launch-smoke.cjs",
    "smoke:backend:fusion-chat-parse": "node scripts/backend/fusion-chat-parse-smoke.cjs",
    "smoke:backend:completion-gate": "node scripts/backend/completion-gate-smoke.cjs",
    "smoke:backend:openfusion-chat-parse": "node scripts/backend/openfusion-chat-parse-smoke.cjs",
    "smoke:backend:openfusion-background-status": "node scripts/backend/openfusion-background-status-smoke.cjs",
    "smoke:backend:openfusion-isolation": "node scripts/backend/openfusion-isolation-smoke.cjs",
    "smoke:backend:openfusion-custom-provider": "node scripts/backend/openfusion-custom-provider-smoke.cjs",
    "smoke:backend:claude-providers": "node scripts/backend/claude-providers-smoke.cjs",
    "smoke:backend:fusion-adapter": "node scripts/backend/fusion-adapter-smoke.cjs",
    "smoke:backend:fusion-watch-build": "node scripts/backend/fusion-watch-build-smoke.cjs",
    "smoke:frontend:attention": "node scripts/frontend/attention-smoke.cjs",
    "smoke:frontend:terminal-runtime": "node scripts/frontend/terminal-runtime-smoke.cjs",
    "smoke:frontend:app-runtime": "node scripts/frontend/app-runtime-smoke.cjs",
    "smoke:frontend:session-persistence": "node scripts/frontend/session-persistence-smoke.cjs",
    "smoke:electron:terminal-board": "node scripts/qa/terminal-board-smoke.cjs",
    "smoke:electron:tiled-drag": "node scripts/qa/tiled-board-drag-smoke.cjs",
    "smoke:electron:terminal-scroll": "node scripts/qa/terminal-scroll-smoke.cjs",
    "smoke:frontend:workspace": "node scripts/frontend/workspace-smoke.cjs",
    "smoke:frontend:session-launch": "node scripts/frontend/session-launch-smoke.cjs",
    "test:frontend:terminal-launch": "node --test scripts/frontend/terminal-launch-coordinator.test.cjs",
    "test:frontend:session-resume": "node --test scripts/frontend/terminal-launch-coordinator.test.cjs scripts/frontend/chat-session-persistence.test.cjs",
    "smoke:electron:session-resume": "node scripts/qa/session-resume-smoke.cjs",
    "test:frontend:voice-pcm": "node --test scripts/frontend/voice-pcm-player.test.cjs",
    "test:frontend:voice-mic-stop": "node --test scripts/frontend/voice-mic-stop.test.cjs",
    "bench:orchestrator:latency": "node scripts/qa/orchestrator-latency-bench.cjs",
    "smoke:frontend:fusion-settings": "node scripts/frontend/fusion-settings-smoke.cjs",
    "smoke:frontend:fusion-delegation-race": "node scripts/frontend/fusion-delegation-race-repro.cjs",
    "smoke:frontend:fusion-interrupt-dedupe": "node scripts/frontend/fusion-interrupt-dedupe-repro.cjs",
    "smoke:frontend:cwd-conflicts": "node scripts/frontend/cwd-conflicts-smoke.cjs",
    "smoke:frontend:tiled-resize": "node scripts/frontend/tiled-board-resize-smoke.cjs",
    "smoke:frontend:pane-split": "node scripts/frontend/pane-split-smoke.cjs",
    "smoke:frontend:terminal-output": "node scripts/frontend/terminal-output-smoke.cjs",
    "test:frontend:terminal-links": "node scripts/frontend/terminal-links.test.cjs",
    "smoke:codex-discovery": "npm run smoke:backend:codex-discovery",
    "typecheck": "tsc --noEmit",
    "gen:codex-bindings": "node scripts/dev/gen-codex-bindings.cjs",
    "check:model-drift": "node scripts/dev/model-drift.cjs",
    "prepare:codex-bin": "node scripts/dev/prepare-codex-bin.cjs",
    "prepare:codex-bin:required": "node scripts/dev/prepare-codex-bin.cjs --required",
    "smoke:backend:fusion-appserver:embedded": "node scripts/backend/fusion-appserver-smoke.cjs --require-embedded",
    "pack:win": "npm run prepare:codex-bin:required && npm run prepare:voice && npm run build && electron-builder --win --dir",
    "dist:win": "npm run prepare:codex-bin:required && npm run prepare:voice && npm run build && electron-builder --win nsis",
    "prepare:voice": "node scripts/dev/verify-error-audio.cjs && node scripts/dev/prepare-voice-models.cjs",
    "test:orchestrator": "node --test scripts/backend/*observed-stop*.test.cjs scripts/backend/orchestrator-*.test.cjs scripts/backend/terminal-observation*.test.cjs scripts/backend/voice*.test.cjs scripts/backend/microphone-*.test.cjs scripts/backend/cli-probe-*.test.cjs scripts/backend/workspace-changes.test.cjs scripts/backend/grok-*.test.cjs scripts/backend/terminal-status-lifecycle.test.cjs scripts/backend/terminal-pending-activity.test.cjs scripts/backend/codex-hook-trust.test.cjs scripts/backend/provider-status-telemetry.test.cjs scripts/backend/claude-task-telemetry.test.cjs scripts/backend/kimi-task-observer.test.cjs scripts/backend/native-status-reconciliation.test.cjs scripts/backend/chat-host-readiness-integration.test.cjs scripts/backend/chat-main-launch-lifecycle.test.cjs",
    "check:orchestrator": "npm run test:orchestrator && node --test scripts/frontend/close-session-operation.test.cjs scripts/frontend/remove-project-operation.test.cjs && npm run smoke:backend:terminal-runtime && npm run smoke:backend:agent-generation && npm run smoke:backend:agent-telemetry && npm run smoke:backend:metadata && npm run smoke:backend:fusion-chat-parse && npm run smoke:backend:openfusion-chat-parse && npm run build && npm run smoke:frontend:terminal-runtime && npm run smoke:frontend:app-runtime && node scripts/frontend/grok-integration-smoke.cjs && npm run test:frontend:session-resume && npm run smoke:frontend:session-persistence && npm run smoke:frontend:session-launch && npm run smoke:frontend:orchestrator-routing && npm run smoke:frontend:orchestrator-dashboard && npm run smoke:frontend:orchestrator-tasks && npm run smoke:frontend:orchestrator-work && npm run smoke:frontend:orchestrator-history && npm run smoke:frontend:voice-experience && npm run test:voice:capture && npm run test:frontend:voice-mic-stop && node scripts/qa/orchestrator-smoke.cjs --hidden && npm run smoke:electron:orchestrator-navigation && npm run smoke:electron:orchestrator-tasks && npm run smoke:electron:session-resume",
    "smoke:frontend:orchestrator-routing": "node scripts/frontend/orchestrator-routing-smoke.cjs",
    "smoke:frontend:workspace-setups": "node scripts/frontend/workspace-setups-smoke.cjs",
    "smoke:electron:orchestrator": "node scripts/qa/orchestrator-smoke.cjs",
    "smoke:electron:orchestrator-command": "node scripts/qa/orchestrator-command-smoke.cjs",
    "smoke:electron:orchestrator-navigation": "node scripts/qa/orchestrator-navigation-smoke.cjs",
    "smoke:electron:orchestrator-background-launch": "node scripts/qa/orchestrator-background-launch-smoke.cjs",
    "smoke:electron:orchestrator-tasks": "node scripts/qa/orchestrator-task-ui-smoke.cjs",
    "smoke:orchestrator:live-tasks": "node scripts/qa/orchestrator-live-tasks.cjs",
    "smoke:frontend:orchestrator-history": "node scripts/frontend/orchestrator-history-smoke.cjs",
    "smoke:frontend:orchestrator-tasks": "node scripts/frontend/orchestrator-tasks-smoke.cjs && node --test scripts/frontend/orchestrator-messages.test.cjs",
    "smoke:frontend:conversation-live": "node scripts/frontend/conversation-live-smoke.cjs",
    "smoke:electron:history-live": "node scripts/qa/history-live-smoke.cjs",
    "smoke:frontend:workspace-dock": "node scripts/frontend/workspace-dock-smoke.cjs",
    "smoke:electron:workspace-controls": "node scripts/qa/workspace-controls-smoke.cjs",
    "smoke:electron:context-history": "node scripts/qa/context-history-smoke.cjs",
    "smoke:frontend:conversation-pages": "node scripts/frontend/conversation-pages-smoke.cjs",
    "smoke:frontend:voice-experience": "node --test scripts/frontend/voice-listening-cue.test.cjs && node scripts/frontend/voice-experience-smoke.cjs",
    "test:voice:capture": "node scripts/frontend/voice-capture-hold.test.cjs",
    "smoke:voice:native": "node scripts/qa/voice-native-smoke.cjs",
    "smoke:voice:workflow": "node scripts/qa/voice-workflow-smoke.cjs",
    "smoke:voice:matrix": "node scripts/qa/voice-keyword-matrix.cjs",
    "smoke:electron:voice-experience": "node scripts/qa/voice-experience-smoke.cjs",
    "smoke:frontend:orchestrator-dashboard": "node scripts/frontend/orchestrator-dashboard-smoke.cjs",
    "smoke:frontend:session-recency": "node scripts/frontend/session-recency-smoke.cjs",
    "smoke:electron:orchestrator-dashboard": "node scripts/qa/orchestrator-dashboard-smoke.cjs",
    "smoke:frontend:orchestrator-work": "node scripts/frontend/orchestrator-work-smoke.cjs",
    "test:frontend": "node --test scripts/frontend/*.test.cjs",
    "smoke:electron:orchestrator-close": "node scripts/qa/orchestrator-close-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "1.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "sherpa-onnx-win-x64": "1.13.7"
  },
  "build": {
    "appId": "com.vibeterminal.app",
    "productName": "Lina Terminal",
    "executableName": "LinaTerminal",
    "artifactName": "LinaTerminal-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "backend/**/*.cjs",
      "shared/**/*.cjs",
      "shared/terminalDisplay.json",
      "node_modules/@xterm/headless/**",
      "node_modules/@xterm/addon-serialize/**",
      "node_modules/node-pty/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "vendor/codex-bin",
        "to": "codex-bin"
      },
      {
        "from": "vendor/kimi-custom",
        "to": "kimi-custom"
      },
      {
        "from": "vendor/voice",
        "to": "voice"
      }
    ],
    "files": [
      "backend/**",
      "shared/**",
      "dist/**",
      "frontend/assets/**",
      "node_modules/**",
      "package.json",
      "preload/**",
      "!**/.tmp/**",
      "!**/artifacts/**",
      "!**/docs/**",
      "!**/scripts/**",
      "!**/vendor/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/assets/vibeterminal-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lina Terminal",
      "uninstallDisplayName": "Lina Terminal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luigicarter",
        "repo": "VibeTerminal",
        "releaseType": "release"
      }
    ]
  }
}
